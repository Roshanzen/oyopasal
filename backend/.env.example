# ==============================================================================
# OyoPasal — Environment Variables Configuration Template
# Multi-Vendor E-Commerce Platform (Nepal)
# Copy this file to `backend/.env` and adjust the variables as required.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=insecure-dev-secret-key-oyopasal-super-secure-change-in-prod
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# ------------------------------------------------------------------------------
# Database Settings (MySQL 8.0+)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=oyopasal_db
DB_USER=oyopasal_user
DB_PASSWORD=oyopasal_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set USE_SQLITE=True to run tests in an isolated in-memory SQLite database
USE_SQLITE=False

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# CORS & CSRF Configuration
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Redis & Celery Settings (Caching & Asynchronous Tasks)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Media Storage & CDN (ImageKit Nepal CDN)
# ------------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ------------------------------------------------------------------------------
# Firebase Admin Authentication (Optional Google Auth)
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Payment Gateways (Sample Test Credentials — Production Integration Deferred)
# ------------------------------------------------------------------------------
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
KHALTI_SECRET_KEY=test_secret_key_68465072045c43d9a9ef1c713b19ccb9

# ------------------------------------------------------------------------------
# Observability & Monitoring (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
